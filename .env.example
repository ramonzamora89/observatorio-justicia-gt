# Copiar a .env y ajustar. El .gitignore excluye .env pero conserva este ejemplo.
#
# La configuracion de fuentes vive en config/sources/*.toml. Estas variables solo
# sobreescriben lo que haga falta en una maquina concreta.

# Nivel de log: DEBUG | INFO | WARNING | ERROR
OBSGT_LOG_LEVEL=INFO

# URL de contacto que viaja en el user-agent del collector.
# OBSGT_CONTACT_URL=https://github.com/<usuario>/observatorio-justicia-gt
